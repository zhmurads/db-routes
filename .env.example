# Порт HTTPS на Mac (слушает только 127.0.0.1): https://localhost:8443
HTTPS_PORT=8443
# Адрес сайта для Caddy
SITE_ADDRESS=localhost
# Контакт для User-Agent запросов к Transitous (требование их политики): e-mail или URL
TRANSITOUS_CONTACT=
# Язык текстов предупреждений из источника (de | en)
UPSTREAM_LANGUAGE=de
# Лимит запросов к /api в минуту с одного IP (автодополнение — вдвое больше)
RATE_LIMIT_PER_MIN=60
REDIS_MAXMEMORY=64mb
# DB Timetables API (https://developers.deutschebahn.com/, план Free): сверка поездов DB с табло
DB_CLIENT_ID=
DB_API_KEY=
# Сколько запросов к Timetables в минуту можно тратить (лимит плана Free — 60)
DB_TT_BUDGET_PER_MIN=50
